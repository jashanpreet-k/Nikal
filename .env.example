# Approximate Gwalior city centre for development; NOT your home.
# Leave both empty to retain the explicit approximate-location label.
NIKAL_LAT=
NIKAL_LON=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
# Alternative: llama3.1:8b (requires its own model pull and license review)
NIKAL_MODEL_TIMEOUT_MS=90000
# Optional. No key means no events search; conditions and places still work.
SERPAPI_KEY=
# Optional city-level search text; blank uses the default Gwalior outdoor query.
# Maximum 120 Unicode characters; controls/formatting characters are rejected.
# Gwalior location is fixed; no saved coordinates or preference memory are inserted.
NIKAL_EVENT_QUERY=
# Default is ~/.nikal. Set an absolute path to isolate a demonstration.
NIKAL_DATA_DIR=
MASTRA_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
# Set this on the Ollama SERVER process too, then restart that server.
OLLAMA_NO_CLOUD=1
